import java.util.Scanner;

abstract class LibraryItem {
    protected String itemTitle;

    public LibraryItem(String itemTitle) {
        this.itemTitle = itemTitle;
    }

    abstract double finePerDay();
}

interface Returnable {
    double returnItem(int daysLate) throws InvalidDaysException;
}

class InvalidDaysException extends Exception {
    public InvalidDaysException(String message) {
        super(message);
    }
}

class Book extends LibraryItem implements Returnable {

    public Book(String itemTitle) {
        super(itemTitle);
    }

    public double finePerDay() {
        return 5.0;
    }

    public double returnItem(int daysLate) throws InvalidDaysException {
        if (daysLate < 0) {
            throw new InvalidDaysException("daysLate cannot be negative");
        }

        return finePerDay() * daysLate;
    }
}

class DVD extends LibraryItem implements Returnable {

    public DVD(String itemTitle) {
        super(itemTitle);
    }

    public double finePerDay() {
        return 10.0;
    }

    public double returnItem(int daysLate) throws InvalidDaysException {
        if (daysLate < 0) {
            throw new InvalidDaysException("daysLate cannot be negative");
        }

        return finePerDay() * daysLate;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int bookDays = input.nextInt();
        int dvdDays = input.nextInt();

        Book book = new Book("Book");
        DVD dvd = new DVD("DVD");

        try {
            double bookFine = book.returnItem(bookDays);
            System.out.printf("Book fine: %.2f%n", bookFine);
        } catch (InvalidDaysException e) {
            System.out.println("Error: " + e.getMessage());
        }

        try {
            double dvdFine = dvd.returnItem(dvdDays);
            System.out.printf("DVD fine: %.2f%n", dvdFine);
        } catch (InvalidDaysException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}