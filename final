import java.util.Scanner;

interface Payable {
    double calculateSalary(int hoursWorked, double rate) throws InvalidHoursException;
}

class InvalidHoursException extends Exception {
    public InvalidHoursException(String message) {
        super(message);
    }
}

class RegularEmployee implements Payable {
    public double calculateSalary(int hoursWorked, double rate) throws InvalidHoursException {
        if (hoursWorked < 0) {
            throw new InvalidHoursException("Hours worked cannot be negative");
        }

        return hoursWorked * rate;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int hoursWorked = input.nextInt();
        double rate = input.nextDouble();

        RegularEmployee employee = new RegularEmployee();

        try {
            double salary = employee.calculateSalary(hoursWorked, rate);
            System.out.printf("Salary: %.2f", salary);
        } catch (InvalidHoursException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}


