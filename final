class PrinterManager {
    private static PrinterManager instance;
    private int jobCount;

    private PrinterManager() {
        jobCount = 0;
    }

    public static PrinterManager getInstance() {
        if (instance == null) {
            instance = new PrinterManager();
        }
        return instance;
    }

    public void printJob(String job) {
        jobCount++;
        System.out.println(job);
    }

    public int getJobCount() {
        return jobCount;
    }
}

public class Main {
    public static void main(String[] args) {
        PrinterManager printer1 = PrinterManager.getInstance();
        PrinterManager printer2 = PrinterManager.getInstance();

        printer1.printJob("Job 1");
        printer2.printJob("Job 2");
        printer1.printJob("Job 3");

        System.out.println("Final job count: " + printer1.getJobCount());
    }
}





